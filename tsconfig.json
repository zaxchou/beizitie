{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@app/root": [
        "src/single/App.tsx"
      ],
      "@/components/study/OriginalPageView": [
        "src/components/study/OriginalPageView.tsx"
      ],
      "@catalog/source": [
        "src/single/catalog-source.ts"
      ],
      "@settings/backup-card": [
        "src/single/SettingsBackupCard.tsx"
      ],
      "@data-page": [
        "src/single/pages/DataPage.tsx"
      ],
      "@pages/market": [
        "src/single/pages/MarketPage.tsx"
      ],
      "@pages/jizi": [
        "src/single/pages/JiziPage.tsx"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__"
  ]
}
